#!/bin/sh
# Launcher: run `desk` from anywhere. Put a symlink to this file on your PATH, e.g.
#   ln -s "$PWD/bin/desk" ~/.local/bin/desk
# DESK_PYTHON picks the Python that has requirements.txt installed (default: python3).
here=$(cd "$(dirname "$(readlink "$0" || echo "$0")")/.." && pwd)
cd "$here" || exit 1
exec "${DESK_PYTHON:-python3}" -m screen_intelligence.desk "$@"
